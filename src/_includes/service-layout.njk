---
layout: base.njk
schemaType: service
---
  {% include "hero.njk" %}

  <section>
    <div class="container service-content">
      <p><a href="{{ backHref }}">&larr; {{ backLabel }}</a></p>

      {% for para in intro | paragraphs %}
      <p class="service-intro">{{ para }}</p>
      {% endfor %}

      <h2>{{ includedHeading or "Our Services" }}</h2>
      <ul class="checklist">
        {% for item in includedItems %}
        <li>{% icon "check" %}<span>{{ item | headline }}</span></li>
        {% endfor %}
      </ul>
    </div>
  </section>

  {% include "cta-band.njk" %}
