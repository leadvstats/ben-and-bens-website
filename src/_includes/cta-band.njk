<section class="cta-band">
  <div class="container">
    <h2>{{ ctaHeading }}</h2>
    <p>{{ ctaText }}</p>
    <div class="phone-row">
      <a href="tel:{{ site.phone1Link }}">{% icon "phone" %} {{ site.phone1 }}</a>
      <a href="tel:{{ site.phone2Link }}">{% icon "phone" %} {{ site.phone2 }}</a>
    </div>
    <div style="margin-top:24px;">
      <a href="contact.html" class="btn">Request a Quote</a>
    </div>
  </div>
</section>
