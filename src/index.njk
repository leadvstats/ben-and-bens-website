  <!-- ===== Hero ===== -->
  {% set heroVariant = "home" %}
  {% set heroButtons = true %}
  {% include "hero.njk" %}

  <!-- ===== Counter boxes (overlap the bottom of the hero) ===== -->
  <div class="counters-wrap">
    <div class="container">
      <div class="counters">
        {% for stat in stats %}
        <div class="counter">
          <div class="counter-number" data-count>{{ stat.number }}</div>
          <div class="counter-label">{{ stat.label }}</div>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- ===== Our Story ===== -->
  <section id="our-story">
    <div class="container">
      <div class="about-story">
        <div class="about-story-photo">
          <img src="{{ storyPhoto }}" alt="{{ storyPhotoAlt }}" />
        </div>
        <div class="about-story-text">
          <p class="eyebrow">{{ storyEyebrow }}</p>
          <h2>{{ storyHeading }}</h2>
          <p>{{ storyParagraph1 }}</p>
          <p>{{ storyParagraph2 }}</p>
          <p>{{ storyParagraph3 }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Services overview ===== -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>{{ servicesHeading }}</h2>
        <p>{{ servicesText }}</p>
      </div>
      <div class="grid">
        {% for service in services %}
        {% include "service-card.njk" %}
        {% endfor %}
      </div>
      <div style="text-align:center; margin-top:40px;">
        <a href="services.html" class="btn">View All Services</a>
      </div>
    </div>
  </section>

  <!-- ===== Our Work ===== -->
  <section class="alt-bg">
    <div class="container">
      <div class="section-head">
        <h2>{{ workHeading }}</h2>
        <p>{{ workText }}</p>
      </div>
      <div class="work-gallery">
        {% for photo in workPhotos %}
        <figure class="work-photo">
          <img src="{{ photo.src }}" alt="{{ photo.alt }}" loading="lazy" />
        </figure>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ===== Why choose us ===== -->
  <section>
    <div class="container">
      <div class="section-head">
        <h2>{{ featuresHeading }}</h2>
      </div>
      <div class="features">
        {% for feature in features %}
        <div class="feature">
          <div class="icon">{% icon feature.icon %}</div>
          <h3>{{ feature.title }}</h3>
          <p>{{ feature.text }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- ===== CTA band ===== -->
  {% include "cta-band.njk" %}
