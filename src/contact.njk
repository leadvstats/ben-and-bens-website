---
layout: base.njk
permalink: /contact.html
title: "Contact & Free Quote | Ben & Ben's Property Services"
description: "Contact Ben & Ben's Property Services for a free quote on dryer vent cleaning, mowing or landscaping. Call 902-233-7677 or send us a message."
ogTitle: "Contact | Ben & Ben's Property Services"
ogDescription: "Get a free quote for dryer vent cleaning, mowing and landscaping."

heroHeading: "Get in Touch"
heroText: "Request a free quote or ask us a question, and we'll get back to you as soon as we can."
---
  <section class="hero">
    <div class="container">
      <h1>{{ heroHeading }}</h1>
      <p>{{ heroText }}</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="contact-wrap">

        <!-- Contact details -->
        <div>
          <h2>Contact Info</h2>
          <ul class="contact-info">
            <li>
              <span class="label">Phone</span>
              <a href="tel:{{ site.phone1Link }}">{{ site.phone1 }}</a><br />
              <a href="tel:{{ site.phone2Link }}">{{ site.phone2 }}</a>
            </li>
            <li>
              <span class="label">Email</span>
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </li>
            <li>
              <span class="label">Hours</span>
              {{ site.hours }}
            </li>
            <li>
              <span class="label">Service Area</span>
              {{ site.serviceAreaText }}
            </li>
          </ul>
        </div>

        <!-- Quote form -->
        <div>
          <h2>Request a Quote</h2>

          <!-- ============================================================
               This form uses Netlify Forms. No signup needed.
               Netlify detects it automatically at deploy time because of
               the data-netlify="true" and name="contact" attributes below.
               Submissions show up in your Netlify site dashboard, and you
               can turn on email notifications there (Site settings ->
               Forms -> Form notifications) to get them by email too.
               ============================================================ -->
          <form name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <p class="visually-hidden">
              <label>Don't fill this out if you're human: <input name="bot-field" /></label>
            </p>

            <label for="name">Name</label>
            <input type="text" id="name" name="name" required />

            <label for="email">Email</label>
            <input type="email" id="email" name="email" required />

            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" />

            <label for="service">Service Needed</label>
            <select id="service" name="service">
              <option>Dryer Vent Cleaning</option>
              <option>Lawn Mowing</option>
              <option>Landscaping</option>
              <option>Garden Design</option>
              <option>Sod Installation</option>
              <option>Excavation</option>
              <option>Hardscaping</option>
              <option>Other / Not Sure</option>
            </select>

            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell us a bit about what you need..." required></textarea>

            <button type="submit" class="btn">Send Request</button>
            <p class="form-note">Prefer to call? Reach us at {{ site.phone1 }} or {{ site.phone2 }}.</p>
          </form>
        </div>

      </div>
    </div>
  </section>
